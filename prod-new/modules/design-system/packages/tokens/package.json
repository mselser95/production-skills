{
  "name": "@ds-scope/tokens",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Brand-neutral design tokens: DTCG JSON sources, alias resolver, CSS and typed TS emitters.",
  "engines": { "node": ">=24 <27" },
  "exports": {
    ".": "./src/index.ts",
    "./css": "./dist/tokens.css",
    "./json": "./dist/tokens.json"
  },
  "files": ["src", "dist"],
  "scripts": {
    "build": "node scripts/build.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
