{
  "name": "prod-test-synth",
  "target": {
    "surface": "prompt",
    "repoPath": "..",
    "skill": "../SKILL.md"
  },
  "benchmark": {
    "format": "openai",
    "timeout": 240000,
    "taskGeneration": {
      "enabled": true,
      "maxTasks": 8,
      "outputDir": "."
    },
    "models": [
      {
        "id": "openai/gpt-5.4",
        "name": "GPT-5.4",
        "tier": "flagship"
      }
    ],
    "output": {
      "dir": "../benchmark-results"
    },
    "verdict": {
      "perModelFloor": 0.6000000000000001,
      "targetWeightedAverage": 0.8
    },
    "authMode": "codex"
  },
  "optimize": {
    "model": "openai/gpt-5.4",
    "allowedPaths": [
      "SKILL.md"
    ],
    "validation": [],
    "maxIterations": 5,
    "authMode": "codex"
  }
}