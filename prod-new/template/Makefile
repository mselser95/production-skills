.PHONY: check-registries verify-standard bench lint test race coverage architecture chaos e2e fuzz verify check-fast test-advisory kill-durability

# check-fast is the staged-presubmit cheap gate: compile + go vet-class
# checks + a plain (no -race) `go test ./...` + architecture. It must stay
# fast (seconds, not minutes) -- `make verify` runs the full lane
# (lint architecture race coverage chaos e2e fuzz) right after it, so
# check-fast exists to catch a trivially broken PR before it pays for the
# full -race + fuzz lane.
check-registries:
	@echo "Checking liability registries (expiry gates the build)..."
	bash scripts/check-registries.sh

check-fast:
	@echo "Checking liability registries..."
	bash scripts/check-registries.sh
	@echo "Building..."
	go build ./...
	@echo "Running go vet..."
	go vet ./...
	@echo "Running tests (no race)..."
	go test -count=1 ./...
	@echo "Running architecture checks..."
	go test -count=1 ./internal/architecture

# test-advisory runs the candidate-provenance test lane: tests behind the
# `candidate` build tag that are not yet ratified/derived invariants. This
# lane is advisory (continue-on-error in CI) -- it must never block a PR.
# The scaffold ships zero candidate tests (nothing has been generated by
# prod-test-synth yet); this target still runs so the lane is proven wired
# from the first commit rather than added later and forgotten.
test-advisory:
	go test -count=1 -tags=candidate ./...

lint:
	@echo "Running golangci-lint..."
	golangci-lint run --timeout=5m

test:
	go test -count=1 ./...

race:
	go test -count=1 -race ./...

coverage:
	./scripts/coverage.sh

architecture:
	go test -count=1 ./internal/architecture

# chaos is a placeholder lane name kept wired from the first commit (the
# gate list every service born from this template must keep, per
# prod-new's Phase 2) even though this scaffold's example capability has no
# fault-injection chaos suite of its own yet -- the outbox's conformance
# kit (extreme_latency, unavailable, crash_between_decision_and_effect
# scenarios) is where that obligation currently lives. Add real chaos
# targets here as this service grows real fault-injected concurrency
# scenarios; until then this runs the same race-detected suite `race` does,
# never silently skipped.
chaos:
	go test -race -count=3 ./...

e2e:
	@name='TestSvc_RealEventLogAndRealTCP_DepositAndWithdrawSurviveARestart'; \
	go test -tags=integration -list "^$${name}$$" ./internal/e2e | grep -qx "$$name" || { echo "missing e2e test: $$name" >&2; exit 1; }; \
	go test -count=1 -tags=integration -race -run="^$${name}$$" ./internal/e2e

# kill-durability is the CONTAINER-level durability check, and the only one in
# this repo that can say anything at all about fsync. It is deliberately NOT in
# `verify`: it needs a docker daemon and it builds an image, so a developer's
# inner loop must not pay for it. CI runs it as its own job (see
# .github/workflows/pr.yaml). Removing the Sync call in
# internal/platform/outboxlog stays GREEN under every unit test in this module
# -- a normally-exiting process flushes its writes anyway -- so this target is
# the only thing that would ever notice.
kill-durability:
	bash scripts/kill-durability.sh

# CHAOS_COUNT / FUZZTIME are overridable so the nightly trends lane
# (.github/workflows/nightly.yaml) can run the same targets at a much
# higher count / longer fuzztime without duplicating the test lists.
CHAOS_COUNT ?= 3
FUZZTIME ?= 5s

# fuzz enumerates every Fuzz* target in the repo. Each is guarded by a
# go-test-list fitness check: renaming a target must fail this loudly
# rather than silently fuzzing nothing.
fuzz:
	@name='FuzzParseAmount'; \
	go test -list "^$${name}$$" ./internal/domain | grep -qx "$$name" || { echo "missing fuzz target: $$name" >&2; exit 1; }; \
	go test -run='^$$' -fuzz="$${name}" -fuzztime=$(FUZZTIME) ./internal/domain
	@name='FuzzDecodeRecord'; \
	go test -list "^$${name}$$" ./internal/platform/eventlog | grep -qx "$$name" || { echo "missing fuzz target: $$name" >&2; exit 1; }; \
	go test -run='^$$' -fuzz="$${name}" -fuzztime=$(FUZZTIME) ./internal/platform/eventlog
	@name='FuzzDecodeOutboxRecord'; \
	go test -list "^$${name}$$" ./internal/platform/outboxlog | grep -qx "$$name" || { echo "missing fuzz target: $$name" >&2; exit 1; }; \
	go test -run='^$$' -fuzz="$${name}" -fuzztime=$(FUZZTIME) ./internal/platform/outboxlog

verify: lint architecture race coverage chaos e2e fuzz

bench:
	@echo "Running benchmarks (recording, never a gate)..."
	go test -run=^$$ -bench=. -benchmem -count=1 ./...

# verify-standard probes every dimension of the production standard and
# PRINTS THE COMPLETION REPORT. It probes EFFECTS (runs the tools, greps
# the entrypoints for wiring, reads the spec's ratified declines), not
# artifacts. Exit 1 on any FAIL: a failing probe is a finding, never a line
# to soften.
verify-standard:
	bash scripts/verify-standard.sh
