#!/usr/bin/env bash
#
# Keep the mirrored copies in step with _shared, automatically.
#
# WHY THIS IS A HOOK AND NOT A CHECK.
#
# install.sh already REFUSES to install when a mirror has drifted, and that
# refusal is correct -- it stops a stale standard entering the trusted set.
# But it fires at the end, on someone who has already forgotten, and the same
# author drifted the same file twice in one day: improve _shared, forget the
# copy, get caught by your own gate.
#
# Twice is not an argument against the gate. It is proof that mirroring is a
# step nobody remembers, and the lesson learned elsewhere in this repo applies:
# a gate that demands a step nobody remembers is a gate that eventually gets
# deleted. So do the step instead of asking for it.
#
# The template's copy has to be a real file -- it is COPIED OUT into a new repo
# and a symlink would dangle on the way -- which is exactly why it can rot. The
# other NINE copies are symlinks into _shared/ and cannot; the eleventh tracked
# path is the canonical file itself, which is what those symlinks point at.
# (Said "ten" until 2026-08-26; re-measured with
# `git ls-files -s | awk '$1=="120000"'`, which counts 9. The old number
# counted the canonical file as one of its own symlinks.)
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

# The list is DERIVED from install.sh, never restated here. It used to be a
# copy, and the copy did exactly what copies do: install.sh grew a second
# mirror (the non-vacuity selftest) and this hook kept syncing one, so the new
# mirror was unprotected at commit time while the commit message claimed the
# gate had run. Two lists that must agree are one list and one latent defect --
# which is the same lesson the comment above already records, applied to the
# comment's own file.
mirrors=()
while IFS= read -r m; do
  [[ -n "$m" ]] && mirrors+=("$m")
# Comment lines are stripped BEFORE the match. The array carries explanatory
# comments (this change added some), and a comment containing a quoted
# colon-string -- `# see "foo:bar" for the format` -- would be extracted as a
# phantom mirror. It could not write a wrong file (the `-f "$orig"` guard below
# skips it), but it would inflate the count, so the hook would report
# "N mirror(s) already in step" for work it never did. A gate that reports a
# number it did not measure is the defect this repo exists to refuse.
done < <(sed -n '/^mirrors=(/,/^)/p' install.sh | grep -v '^[[:space:]]*#' | grep -oE '"[^"]+:[^"]+"' | tr -d '"')

# A derivation that silently returns nothing would make this hook a no-op that
# still prints a reassuring line. If the extraction breaks -- install.sh
# reformatted, the array renamed -- FAIL loudly instead of mirroring zero
# files: silence is not a verdict.
if (( ${#mirrors[@]} == 0 )); then
  echo "pre-commit: could not derive any mirror from install.sh -- refusing to" >&2
  echo "            report success on a check that did not run. Fix the parse" >&2
  echo "            or the array, do not bypass this." >&2
  exit 1
fi

synced=0
for m in "${mirrors[@]}"; do
  copy="${m%%:*}"; orig="${m##*:}"
  [[ -f "$orig" ]] || continue
  if [[ ! -f "$copy" ]] || ! cmp -s "$copy" "$orig"; then
    # Same atomic rename install.sh uses: bash reads a script by offset while
    # executing it, and one of these may be running in another session.
    cp "$orig" "$copy.tmp.$$" && chmod +x "$copy.tmp.$$" && mv "$copy.tmp.$$" "$copy"
    git add "$copy"
    echo "pre-commit: mirrored $orig -> $copy (staged)" >&2
    synced=$((synced+1))
  fi
done

if (( synced == 0 )); then
  echo "pre-commit: ${#mirrors[@]} mirror(s) already in step" >&2
fi

# --- repo-maintenance gates ---------------------------------------------------
#
# These two probes existed and NOTHING invoked them. Not the README, not a
# Makefile, not a hook -- they ran only when someone remembered to type the
# path. That is the same defect this repo has a memory about ("a target that
# exists is not a gate that runs"), sitting in the repo that wrote it.
#
# It is not hypothetical. On 2026-08-29 the closing checklist recorded
# "doctor --static: 0 errors on all nine" from an invocation that was mistyped
# (`claude plugin skill doctor`, which does not exist): it printed
# `error: unknown command 'skill'` and EXITED 0, nine times, and the count of
# "errors" it produced was the error message counting itself. The real tool is
# installed and does work -- but it is run from a checklist, and a checklist is
# where a wrong invocation survives a whole session unnoticed. Running from the
# hook does not make a command correct; it makes SKIPPING one impossible, which
# is the half a checklist cannot give.
#
# The lesson that generalises: a per-subject measurement returning an identical
# verdict for every subject is usually measuring the instrument. Nine skills,
# exactly one "error" each, was the tell.
#
# Both are fast (well under a second) and both fail closed: skills-static exits
# 2 when it finds no subjects at all, policy-coverage exits 2 when it extracts
# zero rows or zero keys, so neither can report clean by checking nothing.
for gate in _shared/probes/skills-static.sh _shared/probes/policy-coverage.sh; do
  if [[ ! -x "$gate" && ! -r "$gate" ]]; then
    # A missing gate is a failure, never a skip. Skipping is precisely how the
    # uninstalled doctor stayed green for a whole session.
    echo "pre-commit: $gate is missing or unreadable -- refusing to commit past" >&2
    echo "            a gate that cannot run. Restore it or remove it here." >&2
    exit 1
  fi
  if ! out=$(bash "$gate" 2>&1); then
    echo "pre-commit: $gate FAILED" >&2
    printf '%s\n' "$out" >&2
    exit 1
  fi
done
echo "pre-commit: skills-static + policy-coverage green" >&2
