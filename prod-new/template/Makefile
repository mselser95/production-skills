.PHONY: check-registries verify-standard verify-standard-group verify-standard-merge bench lint test race coverage architecture chaos e2e fuzz verify check-fast test-advisory kill-durability error-handling-fitness gate-hygiene-fitness help template-drift acceptance acceptance-audit probe-selftests acceptance-audit-selftest-run crash-only-selftest sim load soak
SHELL := /usr/bin/env bash

# check-fast is the staged-presubmit cheap gate: compile + go vet-class
# checks + a plain (no -race) `go test ./...` + architecture. It must stay
# fast (seconds, not minutes) -- `make verify` runs the full lane
# (lint architecture race coverage chaos e2e fuzz) right after it, so
# check-fast exists to catch a trivially broken PR before it pays for the
# full -race + fuzz lane.
check-registries:
	@echo "Checking liability registries (expiry gates the build)..."
	bash scripts/check-registries.sh

check-fast:
	@echo "Checking for unfilled template slots..."
	@bash scripts/no-unfilled-slots.sh
	@echo "Checking liability registries..."
	bash scripts/check-registries.sh
	@$(MAKE) --no-print-directory acceptance
	@echo "Building..."
	go build ./...
	@echo "Running go vet..."
	go vet ./...
	@echo "Running tests (no race)..."
	go test -count=1 ./...
	@echo "Running architecture checks..."
	go test -count=1 ./internal/architecture
	$(MAKE) error-handling-fitness
	$(MAKE) gate-hygiene-fitness
	$(MAKE) crash-only-selftest
	@echo "Sweeping the probe's own presence checks for prose-only evidence..."
	@bash scripts/row-vacuity-sweep.sh
	@echo "Checking this repo is still in step with the standard..."
	@bash scripts/check-template-drift.sh --local

# error-handling-fitness is a FITNESS FUNCTION, sitting beside the import bans
# in internal/architecture rather than beside the tests: it constrains the
# SHAPE of code the repo will accept, and like those bans it is cheap enough
# to belong in the staged presubmit rather than in the full lane.
#
# It is in check-fast for the same reason check-registries is: the three
# handler shapes it refuses (empty branch, TODO branch, log-and-continue past
# an available error return) are the ones Yuan et al. (OSDI 2014) measured
# behind 35% of catastrophic distributed-systems failures, and every one of
# them is cheapest to remove before a reviewer has spent attention on the
# diff. Measured on this scaffold: 0.13s over 82 Go files.
#
# THE SELFTEST RUNS FIRST, and that ordering is the point rather than
# tidiness. The gate is a text pass, so its failure mode is going silently
# green -- a regex that stopped matching prints exactly the same "clean" line
# as a regex that matched everything and found nothing. The selftest drives
# the real script against crafted fixtures and asserts both directions (three
# shapes RED, three correct forms GREEN, zero-inputs RED), so `make
# check-fast` cannot report the gate as satisfied unless the gate has just
# been shown to be capable of failing. Measured: 0.33s.
error-handling-fitness:
	@echo "Proving the error-handling gate can fail..."
	bash scripts/tests/error-handling-fitness-selftest.sh
	@echo "Running error-handling fitness (Yuan et al., OSDI 2014)..."
	bash scripts/error-handling-fitness.sh

# crash-only-selftest exercises the LOGIC of the crash-only state assertion in
# scripts/kill-durability.sh without a docker daemon, by sourcing the script
# through its library seam and driving the real comparison against fixtures.
#
# It is in check-fast, and `kill-durability` deliberately is not, because the
# two answer different questions. The scenario answers "does THIS BUILD
# recover correctly", needs docker, and belongs in its own CI job. This answers
# "can that assertion still fail at all", needs nothing, and is the question
# nobody would otherwise ask -- the scenario runs in exactly one place, so a
# renamed /healthz field or an inverted comparison inside it would show up as
# a green scenario in the environment least able to debug it, and nowhere
# else. Measured: 0.1s, no daemon, no image.
crash-only-selftest:
	@echo "Proving the crash-only state assertion can fail (Candea & Fox, HotOS IX 2003)..."
	bash scripts/tests/kill-durability-state-selftest.sh

# test-advisory runs the candidate-provenance test lane: tests behind the
# `candidate` build tag that are not yet ratified/derived invariants. This
# lane is advisory (continue-on-error in CI) -- it must never block a PR.
# The scaffold ships zero candidate tests (nothing has been generated by
# prod-test-synth yet); this target still runs so the lane is proven wired
# from the first commit rather than added later and forgotten.
test-advisory:
	go test -count=1 -tags=candidate ./...

lint:
	@echo "Running golangci-lint..."
	golangci-lint run --timeout=5m

test:
	go test -count=1 ./...

race:
	go test -count=1 -race ./...

coverage:
	./scripts/coverage.sh

architecture:
	go test -count=1 ./internal/architecture

# chaos is a placeholder lane name kept wired from the first commit (the
# gate list every service born from this template must keep, per
# prod-new's Phase 2) even though this scaffold's example capability has no
# fault-injection chaos suite of its own yet -- the outbox's conformance
# kit (extreme_latency, unavailable, crash_between_decision_and_effect
# scenarios) is where that obligation currently lives. Add real chaos
# targets here as this service grows real fault-injected concurrency
# scenarios; until then this runs the same race-detected suite `race` does,
# never silently skipped.
chaos:
	go test -race -count=3 ./...

e2e:
	@name='TestSvc_RealEventLogAndRealTCP_DepositAndWithdrawSurviveARestart'; \
	go test -tags=integration -list "^$${name}$$" ./internal/e2e | grep -qx "$$name" || { echo "missing e2e test: $$name" >&2; exit 1; }; \
	go test -count=1 -tags=integration -race -run="^$${name}$$" ./internal/e2e

# kill-durability is the CONTAINER-level durability check, and the only one in
# this repo that can say anything at all about fsync. It is deliberately NOT in
# `verify`: it needs a docker daemon and it builds an image, so a developer's
# inner loop must not pay for it. CI runs it as its own job (see
# .github/workflows/pr.yaml). Removing the Sync call in
# internal/platform/outboxlog stays GREEN under every unit test in this module
# -- a normally-exiting process flushes its writes anyway -- so this target is
# the only thing that would ever notice.
kill-durability:
	bash scripts/kill-durability.sh

# CHAOS_COUNT / FUZZTIME are overridable so the nightly trends lane
# (.github/workflows/nightly.yaml) can run the same targets at a much
# higher count / longer fuzztime without duplicating the test lists.
CHAOS_COUNT ?= 3
FUZZTIME ?= 5s

# fuzz enumerates every Fuzz* target in the repo. Each is guarded by a
# go-test-list fitness check: renaming a target must fail this loudly
# rather than silently fuzzing nothing.
fuzz:
	@name='FuzzParseAmount'; \
	go test -list "^$${name}$$" ./internal/domain | grep -qx "$$name" || { echo "missing fuzz target: $$name" >&2; exit 1; }; \
	go test -run='^$$' -fuzz="$${name}" -fuzztime=$(FUZZTIME) ./internal/domain
	@name='FuzzDecodeRecord'; \
	go test -list "^$${name}$$" ./internal/platform/eventlog | grep -qx "$$name" || { echo "missing fuzz target: $$name" >&2; exit 1; }; \
	go test -run='^$$' -fuzz="$${name}" -fuzztime=$(FUZZTIME) ./internal/platform/eventlog
	@name='FuzzDecodeOutboxRecord'; \
	go test -list "^$${name}$$" ./internal/platform/outboxlog | grep -qx "$$name" || { echo "missing fuzz target: $$name" >&2; exit 1; }; \
	go test -run='^$$' -fuzz="$${name}" -fuzztime=$(FUZZTIME) ./internal/platform/outboxlog

# check-fast FIRST, and it is not a convenience. Until 2026-08-28 `verify` did
# not include it, and ci.yaml runs `make verify` and nothing else -- so on that
# path the registry expiries, the error-handling fitness, the gate-hygiene
# fitness, the crash-only selftest and the template-drift check never ran at
# all. pr.yaml happened to invoke check-fast separately, which is why nobody
# noticed: the gates were reachable on one route and absent on the other, and
# the lane documented as "the full presubmit" was the one missing them.
verify: check-fast lint architecture race coverage chaos e2e fuzz acceptance-audit

bench:
	@echo "Running benchmarks (recording, never a gate)..."
	go test -run=^$$ -bench=. -benchmem -count=1 ./...

# load and soak are the two LANES `bench` cannot cover, and the distinction is
# not a matter of duration. `bench` measures ONE operation in isolation, in
# process, with no arrivals and no queue -- it answers "how long does this take"
# and is structurally incapable of answering "what happens when they arrive
# faster than that". Every property worth knowing about a system under traffic
# (where throughput stops tracking offered load, whether the tail collapses
# before it, whether anything grows without bound) lives in the gap between
# those two questions.
#
# Both are deliberately OUT of `verify`, for the same reason kill-durability is:
# they start a real process and run for minutes, and a developer's inner loop
# must not pay for that. CI runs them in the nightly trends lane.

# load sweeps rising arrival rates against a locally started service and writes
# benchmarks/load/baseline.md -- the artifact benchmarks/load/baseline-TEMPLATE.md
# describes. Non-zero exit means the sweep did NOT produce a usable capacity
# number: it never saturated (a lower bound, not a measurement -- raise RATES),
# every row was spoiled by the generator falling behind its own schedule, or a
# declared TARGET_RPS was missed by more than tier-policy.yaml's 2x margin.
#
# TARGET_RPS and LATENCY_BUDGET_MS have no defaults on purpose. They are facts
# about what this service must do, which no scaffold can supply, and defaulting
# them would produce a capacity gate that passes every service forever.
load:
	@echo "Sweeping offered load (open-loop; writes benchmarks/load/baseline.md)..."
	bash benchmarks/load/sweep.sh

# soak holds a sustained rate for SOAK_MINUTES and fails on resource growth that
# does not level off -- goroutines, file descriptors and RSS, sampled from the
# OPERATING SYSTEM rather than from anything the service says about itself.
#
# This is the one lane that can see a leak. A leak is invisible to every other
# gate here by construction: the service stays correct, stays fast, passes
# -race, and grows a few descriptors a minute until the fourth day of a deploy.
#
# The verdict logic lives in benchmarks/load/growth-check.sh, which reads a
# sample table on stdin -- so "does this detector actually go red on a leak" is
# answerable in a second against a synthetic series, instead of only by leaking
# for half an hour.
SOAK_MINUTES ?= 30
soak:
	@echo "Soaking for $(SOAK_MINUTES) minute(s) under sustained load..."
	SOAK_MINUTES=$(SOAK_MINUTES) bash benchmarks/load/soak.sh

# sim runs the stage-1 deterministic simulation harness
# (verification/simulation) -- a seeded schedule of ~500 operations and
# injected faults driven through internal/app.Ledger, asserting the ratified
# invariants at every step.
#
# SIM_SEED is why this target exists separately from `test`. Unset, the
# harness runs its fixed default seed, which is as deterministic as any other
# test in this module and already runs in the ordinary `go test ./...` lane.
# Overriding it sweeps other schedules (SIM_SEED=$$RANDOM make sim), and THAT
# lane is advisory: a red on a seed nobody has seen before is a finding to
# minimize into regressions/, not a reason to stop a merge. Dimension 27 is
# advisory for the same reason -- a required probe row would buy every repo a
# verification/simulation/ directory, which is the vacuous form of having a
# simulator. SIM_SEED is passed through the environment by go test, so no
# -exec plumbing is needed here; it is named in this comment because a knob
# no target mentions is a knob nobody finds.
#
# -v is deliberate: the harness logs its seed and its schedule-adequacy
# counters, and a run whose seed is not in the output cannot be reproduced
# from it -- which is the one property this harness exists to provide.
# -count=1 because a cached PASS says nothing about this tree.
#
# BOTH tests run, and the second one is not optional: TestSimulation_
# SeedReproduces runs one seed twice and compares the decision traces byte
# for byte. A seed that does not reproduce turns every red run back into a
# story, which is the failure this whole harness exists to avoid -- so the
# check ships with it rather than after it.
#
# The name guard mirrors the fuzz and e2e targets: renaming either test must
# fail loudly here rather than silently simulating nothing.
#
# It differs from them in one place, and the difference was measured rather
# than reasoned: `go test -list ... | grep -qx` pipes away the exit status, so
# a package that does not COMPILE reports as "missing simulation test", which
# sends the reader hunting for a rename that never happened. (Observed while
# mutation-testing this target: a deliberate compile error in
# internal/domain printed exactly that.) Checking the list command's status
# first costs one line and makes the two failures say what they are.
sim:
	@list=$$(go test -list '^TestSimulation_' ./verification/simulation) || { echo "$$list" >&2; echo "simulation package failed to build -- see the compiler output above" >&2; exit 1; }; \
	for name in TestSimulation_SeededFaultSchedule TestSimulation_SeedReproduces; do \
	  printf '%s\n' "$$list" | grep -qx "$$name" || { echo "missing simulation test: $$name" >&2; exit 1; }; \
	done; \
	go test -count=1 -v -run='^TestSimulation_' ./verification/simulation

# verify-standard probes every dimension of the production standard and
# PRINTS THE COMPLETION REPORT. It probes EFFECTS (runs the tools, greps
# the entrypoints for wiring, reads the spec's ratified declines), not
# artifacts. Exit 1 on any FAIL: a failing probe is a finding, never a line
# to soften.
verify-standard:
	bash scripts/verify-standard.sh

# The same probe, one group at a time, and the aggregator -- what CI runs as
# parallel jobs on separate checkouts (see .github/workflows/pr.yaml).
# `make verify-standard` above is unchanged and runs everything.
#   make verify-standard-group GROUP=suite    (suite | dynamic | fuzzbench | static)
#   make verify-standard-merge                (after every group has run)
# Locally, run the groups ONE AFTER ANOTHER: `dynamic` mutates production source
# (non-vacuity) and nothing may read the tree meanwhile. Two probes started on
# one checkout serialise on the probe's lock, and one that cannot take it exits.
# Results land in .prod/verify-standard/ (gitignored), which is where the merge
# target reads them.
verify-standard-group:
	@test -n "$(GROUP)" || { echo "usage: make verify-standard-group GROUP=<suite|dynamic|fuzzbench|static>" >&2; exit 2; }
	bash scripts/verify-standard.sh --group "$(GROUP)"

verify-standard-merge:
	bash scripts/verify-standard.sh --merge .prod/verify-standard/*.json

# Prove the verifier before trusting its verdict. Each selftest drives
# verify-standard.sh's own row logic against crafted fixtures and asserts BOTH
# directions. Listed individually rather than globbed: `for f in
# scripts/tests/*-selftest.sh` reports success over an empty glob if the
# directory is ever renamed, which is the fail-open shape every one of these
# files exists to refuse. Cheap (no Go toolchain, no network), so it belongs
# here beside the probe it certifies.
# The gate that reads the GATES. Separate from error-handling-fitness because
# its subject is different: that one reads Go handlers, this one reads the
# shell scripts that decide whether every other check ran.
gate-hygiene-fitness:
	bash scripts/gate-hygiene-fitness.sh

# Currency, not integrity. --local needs no template and so runs anywhere,
# including CI; the full check (are we behind upstream?) needs the installed
# template and is a developer/agent-side question.
template-drift:
	bash scripts/check-template-drift.sh

probe-selftests:
	bash scripts/tests/load-rows-selftest.sh
	bash scripts/tests/probe-self-gate-selftest.sh
	bash scripts/tests/sbom-ordering-selftest.sh
	bash scripts/tests/check-registries-selftest.sh
	bash scripts/tests/non-vacuity-selftest.sh
	bash scripts/tests/retry-selftest.sh
	bash scripts/tests/gate-run-selftest.sh
	bash scripts/tests/observability-provenance-selftest.sh
	bash scripts/tests/coverage-ratchet-selftest.sh
	bash scripts/tests/single-suite-run-selftest.sh
	bash scripts/tests/acceptance-coverage-selftest.sh
	@$(MAKE) --no-print-directory acceptance-audit-selftest-run
	bash scripts/tests/changed-line-coverage-selftest.sh
	bash scripts/tests/acceptance-gap-selftest.sh
	bash scripts/tests/check-template-drift-selftest.sh
	bash scripts/tests/probe-selftests-skip-selftest.sh

# The acceptance-audit selftest exits 3 (SKIPPED, nothing run) when scripts/changed-line-coverage.sh was
# customised: template-format stubs cannot drive it. 0 passes; 1 and 2 fail; 3 passes ONLY when
# registries/contract-debt.yaml records the customisation -- an entry whose evidence (or path) field
# names scripts/changed-line-coverage.sh -- so a skip is a dated, owned, expiring liability
# (check-registries.sh enforces the expiry), never a silent pass.
ACCEPTANCE_AUDIT_SELFTEST ?= scripts/tests/acceptance-audit-selftest.sh
acceptance-audit-selftest-run:
	@rc=0; bash "$(ACCEPTANCE_AUDIT_SELFTEST)" || rc=$$?; \
	  [ "$$rc" -ne 0 ] || exit 0; \
	  if [ "$$rc" -ne 3 ]; then echo "probe-selftests: FAIL -- acceptance-audit selftest exited $$rc"; exit 1; fi; \
	  id=""; [ ! -f registries/contract-debt.yaml ] || id=$$(awk 'function flush() { if (!done && inent && hit && eid != "") { done = 1; print eid; exit } } \
	    function tok(s,   p, off, rest, b, a) { off = 0; rest = s; while ((p = index(rest, P)) > 0) { b = (off + p > 1) ? substr(s, off + p - 1, 1) : " "; a = substr(s, off + p + length(P), 1); \
	      if (index(" \"\047[,", b) > 0 && (a == "" || index(" \"\047],", a) > 0)) return 1; off += p; rest = substr(s, off + 1) } return 0 } \
	    function field(body,   val) { if (body ~ /^[A-Za-z_][A-Za-z0-9_-]*:/) { key = body; sub(/:.*/, "", key); val = body; sub(/^[^:]*:[ ]*/, "", val); \
	      if (key == "id") { eid = val; gsub(/["\047 ]/, "", eid) } else if ((key == "evidence" || key == "path") && tok(val)) hit = 1 } else key = "" } \
	    BEGIN { P = "scripts/changed-line-coverage.sh" } \
	    /^[ ]*#/ || /^[ ]*$$/ { next } \
	    { match($$0, /[^ ]/); ind = RSTART - 1 } \
	    /^[ ]*-([ ]|$$)/ && (!inent || ind <= d) { flush(); inent = 1; d = ind; hit = 0; eid = ""; key = ""; match($$0, /-[ ]*/); kind = ind + RLENGTH; field(substr($$0, kind + 1)); next } \
	    !inent { next } \
	    ind <= d { flush(); inent = 0; next } \
	    ind == kind && $$0 !~ /^[ ]*-([ ]|$$)/ { field(substr($$0, kind + 1)); next } \
	    (key == "evidence" || key == "path") && tok($$0) { hit = 1 } \
	    END { flush() }' registries/contract-debt.yaml); \
	  if [ -n "$$id" ]; then echo "probe-selftests: acceptance-audit selftest SKIPPED, honoured by contract-debt entry $$id"; exit 0; fi; \
	  echo "probe-selftests: FAIL -- acceptance-audit selftest skipped (customised scripts/changed-line-coverage.sh) and registries/contract-debt.yaml does not record it"; exit 1

# acceptance: every acceptance/<feature>.yaml is complete, approved, and traced
# to tests both ways (_shared/formats/acceptance-spec.md in production-skills).
# Zero specs is SAID, not passed silently: "nothing to check yet" and "checked,
# all fine" must not print the same line.
acceptance:
	@set -e; n=0; \
	  for s in acceptance/*.yaml; do \
	    [ -f "$$s" ] || continue; \
	    bash scripts/acceptance-coverage.sh "$$s"; n=$$((n+1)); \
	  done; \
	  if [ "$$n" -eq 0 ]; then echo "acceptance: 0 specs -- nothing checked yet (features start at prod-spec, which writes acceptance/<feature>.yaml)"; \
	  else echo "acceptance: $$n spec(s) checked"; fi

# acceptance-audit: the code the feature ADDED must be EXERCISED by the
# acceptance suite, not merely green (2606.28430: a green oracle over dead
# code). Runs internal/e2e with a coverage profile over ./..., then asks the
# existing scripts/changed-line-coverage.sh (COVERAGE_OUT, base ref
# CHANGED_LINE_COVERAGE_BASE, default origin/main) how much of the diff the
# run executed; below ACCEPTANCE_AUDIT_FLOOR percent fails. Runs the
# integration lane, so it is in `verify`, NOT in check-fast. Fails closed:
# a missing/empty profile (changed-line-coverage.sh would otherwise fall back
# to scoring the UNIT suite into the same path) and a 0/0 result are FAILs,
# except 0/0 over a genuinely empty Go diff, which is said and passes.
#
# What is measured is DELIVERED code: a test double, or another suite's harness,
# that is not a _test.go file is not delivered code and cannot be reached by an
# acceptance run that uses the real implementation, so counting it only drags the
# figure down for a reason that says nothing about the feature. A repo that has
# such files sets ACCEPTANCE_AUDIT_EXCLUDES to git pathspec exclusions, e.g.
#   ACCEPTANCE_AUDIT_EXCLUDES := :(exclude,glob)test/** :(exclude,glob)**/*test/**
# (passed to changed-line-coverage.sh as CHANGED_LINE_EXTRA_EXCLUDES, by this
# target only; entries not starting with ':!' or ':(exclude' are refused). It is
# empty here: the template has no test-support packages outside _test.go. The
# exclusion narrows WHAT is measured; it does not lower ACCEPTANCE_AUDIT_FLOOR.
# An excluded path must be test support, never production code, and review is
# where that is checked. A diff whose only Go changes are tests and excluded
# files is said ("nothing to audit"), not failed; any other 0/0 still fails.
# The "removed N file(s)" count is over the range the measurement uses (BASE...HEAD, the
# merge-base, committed changes) plus what is staged or modified on top of HEAD (a base that is
# not an ancestor no longer inflates it with files only the base side changed); a 0/0 pass needs the diff empty under BOTH that range and
# the working tree, so uncommitted Go changes (not measured) and a diverged base fail closed.
# An exclusion entry that matches no changed file is printed (stale), not failed.
ACCEPTANCE_AUDIT_FLOOR ?= 80
ACCEPTANCE_AUDIT_EXCLUDES ?=
ACCEPTANCE_AUDIT_COVER_DIR ?= .prod/coverage
#
# BINARY COVERAGE MODE (opt-in). The default measurement above is the coverage of
# the code the test BINARY imports. A service whose acceptance suite BUILDS the
# service and runs it as a separate PROCESS is not measured that way: the profile
# then covers the test harness, and the audit would gate on a number about the
# harness. Such a repo sets ACCEPTANCE_AUDIT_BINARY_COVER_ENV to the NAME of an
# environment variable its acceptance harness reads (a plain name, [A-Za-z_][A-Za-z0-9_]*).
# The target then runs the suite with that variable set to an absolute directory
# (<ACCEPTANCE_AUDIT_COVER_DIR>/binary, emptied each run), WITHOUT -coverpkg and
# -coverprofile, converts the counters the instrumented processes wrote with
# `go tool covdata textfmt`, and feeds that profile to the same changed-line
# tail below. It fails if no counters were written, if covdata fails, or if the
# profile names no file outside _test.go, testdata/ and internal/e2e*/ (the
# service was not measured). HARNESS CONTRACT, owed by the repo that sets the
# variable: when the named variable is set the harness builds the service with
#   go build -cover -coverpkg=./... -covermode=set
# starts every service process with GOCOVERDIR=<that directory>, and stops each
# process with SIGTERM and waits for it (a SIGKILLed process writes no counters).
# The template's own example suite runs in-process, so it leaves the variable
# empty. Needs Go 1.20 or later.
# A repo adopts the mode by setting the variable in this Makefile (`ACCEPTANCE_AUDIT_BINARY_COVER_ENV :=
# <NAME>` is fine, so is `?=`) or on the make command line. The vendored acceptance-audit selftest
# drives both modes explicitly on the make command line, which beats `:=`, so it passes for a repo
# that adopts the mode and for one that leaves it empty.
# ACCEPTANCE_AUDIT_TIMEOUT (empty: no -timeout flag) is a go test -timeout such as
# 30m, for a suite that builds and starts binaries; it applies in both modes.
ACCEPTANCE_AUDIT_BINARY_COVER_ENV ?=
ACCEPTANCE_AUDIT_TIMEOUT ?=
# These values reach the recipe as DATA, never as shell text. FLOOR and EXCLUDES are
# exported and read in the recipe only as "$$ACCEPTANCE_AUDIT_FLOOR" and
# "$$ACCEPTANCE_AUDIT_EXCLUDES", so a quote, $(...), backtick or newline in them is
# inert (a pasted $(ACCEPTANCE_AUDIT_EXCLUDES) inside quotes let `x';touch f;'` run a
# command). COVER_DIR is a path used in two commands; it stays a make expansion, but a
# value containing a quote, $, backtick or backslash is replaced by a marker the recipe
# refuses, so it cannot reach the shell. FLOOR must be a plain number or the recipe fails.
_aa_unsafe = $(or $(findstring ",$(1)),$(findstring ',$(1)),$(findstring $$,$(1)),$(findstring `,$(1)),$(findstring \,$(1)))
export ACCEPTANCE_AUDIT_FLOOR ACCEPTANCE_AUDIT_EXCLUDES ACCEPTANCE_AUDIT_BINARY_COVER_ENV ACCEPTANCE_AUDIT_TIMEOUT
acceptance-audit: override ACCEPTANCE_AUDIT_COVER_DIR := $(if $(call _aa_unsafe,$(ACCEPTANCE_AUDIT_COVER_DIR)),__unsafe_cover_dir__,$(ACCEPTANCE_AUDIT_COVER_DIR))
acceptance-audit:
	@set -e; PROFILE="$(ACCEPTANCE_AUDIT_COVER_DIR)/acceptance.out"; BASE="$${CHANGED_LINE_COVERAGE_BASE:-origin/main}"; EXCL="$$ACCEPTANCE_AUDIT_EXCLUDES"; FLOOR="$$ACCEPTANCE_AUDIT_FLOOR"; n=0; \
	  [ "$(ACCEPTANCE_AUDIT_COVER_DIR)" != "__unsafe_cover_dir__" ] || { echo "acceptance-audit: FAIL -- ACCEPTANCE_AUDIT_COVER_DIR contains a quote, \$$, backtick or backslash: refused"; exit 1; }; \
	  case "$$FLOOR" in ''|*[!0-9.]*|*.*.*) echo "acceptance-audit: FAIL -- ACCEPTANCE_AUDIT_FLOOR is not a plain number"; exit 1;; esac; \
	  BENV="$$ACCEPTANCE_AUDIT_BINARY_COVER_ENV"; TMO="$$ACCEPTANCE_AUDIT_TIMEOUT"; \
	  case "$$BENV" in '') ;; [!A-Za-z_]*|*[!A-Za-z0-9_]*) echo "acceptance-audit: FAIL -- ACCEPTANCE_AUDIT_BINARY_COVER_ENV is not a plain environment variable name"; exit 1;; esac; \
	  case "$$TMO" in '') ;; *[!0-9smh]*|[!0-9]*|*[smh]?*|*[0-9]) echo "acceptance-audit: FAIL -- ACCEPTANCE_AUDIT_TIMEOUT is not a duration like 30m"; exit 1;; esac; \
	  for s in acceptance/*.yaml; do [ -f "$$s" ] && n=$$((n+1)); done; \
	  if [ "$$n" -eq 0 ]; then echo "acceptance-audit: 0 specs -- nothing to audit yet"; exit 0; fi; \
	  set -f; set --; for e in $$EXCL; do case "$$e" in \
	      :*) case "$$e" in :/*) p="";; :\(*\)*) p="$${e#*\)}";; :[\!^]*) p="$${e#:?}";; *) p="$${e#:}";; esac; \
	        case "$$p" in /*) echo "acceptance-audit: FAIL -- ACCEPTANCE_AUDIT_EXCLUDES entry is an absolute path"; exit 1;; esac; set -- "$$@" "$$e";; \
	    esac; done; \
	  if [ "$$#" -gt 0 ]; then \
	    all_go=$$(git ls-files -- '*.go' ':(exclude)*_test.go' | head -n 1); \
	    if [ -n "$$all_go" ] && kept_go=$$(git ls-files -- '*.go' ':(exclude)*_test.go' "$$@" 2>/dev/null) && [ -z "$$kept_go" ]; then \
	      echo "acceptance-audit: FAIL -- ACCEPTANCE_AUDIT_EXCLUDES excludes every delivered Go file; nothing would be measured"; exit 1; fi; fi; \
	  set +f; \
	  mkdir -p "$(ACCEPTANCE_AUDIT_COVER_DIR)"; rm -f "$$PROFILE"; \
	  set --; [ -z "$$TMO" ] || set -- -timeout "$$TMO"; \
	  if [ -n "$$BENV" ]; then \
	    case "$(ACCEPTANCE_AUDIT_COVER_DIR)" in /*) COVDIR="$(ACCEPTANCE_AUDIT_COVER_DIR)/binary";; *) COVDIR="$$(pwd)/$(ACCEPTANCE_AUDIT_COVER_DIR)/binary";; esac; \
	    rm -rf "$$COVDIR"; mkdir -p "$$COVDIR"; \
	    env "$$BENV=$$COVDIR" go test -count=1 -tags=integration "$$@" ./internal/e2e/...; \
	    [ -n "$$(find "$$COVDIR" -type f -name 'covcounters.*' | head -n 1)" ] || { echo "acceptance-audit: FAIL -- no coverage counters were written: the service binary was not instrumented (or no process exited normally)"; exit 1; }; \
	    go tool covdata textfmt -i="$$COVDIR" -o="$$PROFILE" || { echo "acceptance-audit: FAIL -- go tool covdata textfmt exited non-zero: the binary coverage counters could not be converted"; exit 1; }; \
	  fi; \
	  [ -n "$$BENV" ] || \
	  go test -count=1 -tags=integration "$$@" -coverpkg=./... -coverprofile="$$PROFILE" ./internal/e2e/...; \
	  [ -s "$$PROFILE" ] || { echo "acceptance-audit: FAIL -- acceptance run wrote no coverage profile (nothing was measured)"; exit 1; }; \
	  if [ -n "$$BENV" ]; then \
	    if ! grep -v '^mode:' "$$PROFILE" | cut -d: -f1 | grep -Ev '_test\.go$$|/testdata/|/internal/e2e[^/]*/' | grep -q .; then \
	      echo "acceptance-audit: FAIL -- the profile names no file outside the test-support packages: the service was not measured"; exit 1; fi; fi; \
	  rc=0; out=$$(CHANGED_LINE_EXTRA_EXCLUDES="$$EXCL" COVERAGE_OUT="$$PROFILE" CHANGED_LINE_COVERAGE_BASE="$$BASE" bash scripts/changed-line-coverage.sh 2>&1) || rc=$$?; echo "$$out"; \
	  [ "$$rc" -eq 0 ] || { echo "acceptance-audit: FAIL -- changed-line-coverage.sh exited $$rc"; exit 1; }; \
	  line=$$(printf '%s\n' "$$out" | grep '^changed-line coverage: [0-9.]*% ' | tail -n 1); \
	  pct=$$(printf '%s' "$$line" | sed -E 's/^changed-line coverage: ([0-9.]+)%.*/\1/'); \
	  tot=$$(printf '%s' "$$line" | sed -E 's/.*\/([0-9]+) lines\).*/\1/'); \
	  [ -n "$$pct" ] && [ -n "$$tot" ] || { echo "acceptance-audit: FAIL -- no changed-line coverage figure produced"; exit 1; }; \
	  have_excl=0; [ -z "$$(printf %s "$$EXCL" | tr -d ' \t\n')" ] || have_excl=1; \
	  excl_line=$$(printf %s "$$EXCL" | tr '\n\t' '  ' | tr -s ' ' | sed -e 's/^ //' -e 's/ $$//'); \
	  RANGE="$$BASE...HEAD"; \
	  nprod() { { git diff --name-only "$$RANGE" -- '*.go' ':(exclude)*_test.go' "$$@"; git diff --name-only HEAD -- '*.go' ':(exclude)*_test.go' "$$@"; } | sort -u | wc -l | tr -d ' '; }; \
	  quiet() { git diff --quiet "$$BASE" -- "$$@" && git diff --quiet "$$RANGE" -- "$$@"; }; \
	  removed="unknown (base missing or no merge base)"; have_range=0; \
	  if git rev-parse --verify "$$BASE" >/dev/null 2>&1 && git merge-base "$$BASE" HEAD >/dev/null 2>&1; then have_range=1; fi; \
	  if [ "$$have_excl" = 1 ] && [ "$$have_range" = 1 ]; then \
	    all=$$(nprod); set -f; kept=$$(nprod $$EXCL); removed=$$((all-kept)); \
	    for e in $$EXCL; do [ "$$(nprod "$$e")" != "$$all" ] || echo "acceptance-audit: exclusion '$$e' matched no changed file (a stale entry? nothing it names changed in $$RANGE)"; done; set +f; fi; \
	  if [ "$$tot" = "0" ]; then \
	    if [ "$$have_range" = 1 ] && quiet '*.go'; then \
	      echo "acceptance-audit: 0 changed Go lines vs $$BASE -- nothing to audit"; exit 0; fi; \
	    if [ "$$have_range" = 1 ] && quiet '*.go' ':(exclude)*_test.go'; then \
	      echo "acceptance-audit: 0 changed non-test Go lines vs $$BASE (only test files changed) -- nothing to audit"; exit 0; fi; \
	    if [ "$$have_excl" = 1 ] && [ "$$have_range" = 1 ] && { set -f; quiet '*.go' ':(exclude)*_test.go' $$EXCL; }; then \
	      echo "acceptance-audit: 0 changed delivered Go lines vs $$BASE -- only test files and files excluded by ACCEPTANCE_AUDIT_EXCLUDES changed; exclusions [$$excl_line] removed $$removed changed non-test Go file(s) from the audit -- nothing to audit"; exit 0; fi; \
	    echo "acceptance-audit: FAIL -- 0/0 changed lines but the Go diff vs $$BASE is not empty (or base missing): unmeasurable"; exit 1; fi; \
	  if [ "$$have_excl" = 1 ]; then echo "acceptance-audit: exclusions [$$excl_line] removed $$removed changed non-test Go file(s) from the audit"; fi; \
	  if awk -v p="$$pct" -v f="$$FLOOR" 'BEGIN{exit !(p+0>=f+0)}'; then \
	    echo "acceptance-audit: $$pct% >= $$FLOOR% floor over $$n spec(s)"; \
	  else echo "acceptance-audit: FAIL -- $$pct% of changed lines executed by the acceptance run < $$FLOOR% floor"; exit 1; fi

help:
	@echo "acceptance        every acceptance/<feature>.yaml complete, approved, traced to tests (in check-fast)"
	@echo "acceptance-audit  >= ACCEPTANCE_AUDIT_FLOOR (default 80)% of changed lines executed by the acceptance run (in verify)"
